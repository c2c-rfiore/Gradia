using Gtk 4.0;
using Adw 1;

template $GradiaBackgroundSelector: Adw.Bin {
  child: Gtk.Box container {
    orientation: vertical;
    spacing: 12;

    Adw.PreferencesGroup background_group {
      Adw.ExpanderRow background_expander {
        title: _("Background");
        expanded: true;

        Adw.ActionRow mode_row {
          activatable: false;
          selectable: false;

          child: $GradiaToggleGroup toggle_group {
            margin-top: 6;
            margin-bottom: 6;

            notify::active-name => $_on_group_changed();
          };
        }
      }
    }

    // The selected mode's settings are their own section, so they read like
    // every other block in the sidebar instead of a menu inside a menu.
    Revealer stack_revealer {
      transition-type: slide_up;
      transition-duration: 250;

      Gtk.Stack stack {
        transition-type: crossfade;
        transition-duration: 250;
        hexpand: true;
        valign: start;
      }
    }
  };
}
